ACCURATE_EMAIL=your-email@example.com
ACCURATE_PASSWORD=your-password
ACCURATE_COMPANY_NAME=KSC
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_BROWSER_CHANNEL=chrome
PLAYWRIGHT_BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
PLAYWRIGHT_CHROME_PROFILE_DIRECTORY=Default
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_SLOW_MO=300
PLAYWRIGHT_USER_DATA_DIR=./output/playwright/user-data
GOOGLE_DRIVE_FOLDER_NAME=accurate_id
ACCURATE_DATE_MODE=daily
ACCURATE_START_DATE=
ACCURATE_END_DATE=

# If you want to reuse your real Chrome login profile, point PLAYWRIGHT_USER_DATA_DIR
# to your Chrome user data dir and set the correct profile directory.
# Linux example:
# PLAYWRIGHT_USER_DATA_DIR=/home/your-user/.config/google-chrome
# PLAYWRIGHT_CHROME_PROFILE_DIRECTORY=Default
# Windows example:
# PLAYWRIGHT_USER_DATA_DIR=C:\Users\your-user\AppData\Local\Google\Chrome\User Data
# PLAYWRIGHT_CHROME_PROFILE_DIRECTORY=Default

# Windows example:
# PLAYWRIGHT_BROWSER=chromium
# PLAYWRIGHT_BROWSER_CHANNEL=chrome
# PLAYWRIGHT_BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# PLAYWRIGHT_HEADLESS=false
# PLAYWRIGHT_SLOW_MO=300
# PLAYWRIGHT_USER_DATA_DIR=./output/playwright/user-data
# GOOGLE_DRIVE_FOLDER_NAME=accurate_id

# Optional: override labels if the UI text in your account differs.
# ACCURATE_URL=https://account.accurate.id/?lang=US
# ACCURATE_SIDEBAR_LABEL=Reports
# ACCURATE_REPORT_LIST_LABEL=Report List
# ACCURATE_FINANCIAL_LABEL=Financial
# ACCURATE_PROFIT_LOSS_LABEL=Profit/Loss (Standard)
# ACCURATE_OUTPUT_DIR=./output/playwright/downloads

# Optional: override AutoHotkey executable path on Windows.
# AHK_EXE_PATH=C:\Program Files\AutoHotkey\v2\AutoHotkey64.exe

# Optional: override the AutoHotkey script path.
# AHK_SCRIPT_PATH=.\save-accurate-export.ahk
