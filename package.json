{
  "name": "ksc-playwright-export",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright automation script for Accurate report export.",
  "main": "src/ksc-export.js",
  "scripts": {
    "start": "node src/ksc-export.js",
    "bot:start": "node src_bot/server.js",
    "custom:start": "node src_custom/ksc-export.js",
    "check": "node --check src/ksc-export.js",
    "bot:check": "node --check src_bot/server.js",
    "custom:check": "node --check src_custom/ksc-export.js",
    "doctor": "node scripts/doctor.js",
    "install:browsers": "playwright install chromium",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "playwright": "1.59.1"
  }
}
